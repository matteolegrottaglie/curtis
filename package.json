{
  "name": "linkedin-sequencer-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server MCP che automatizza LinkedIn dal tuo computer: login, import di una lista di contatti e invio graduale delle richieste di collegamento, comandato interamente da chat (Claude Code, Codex).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.2"
  },
  "bin": {
    "lksq": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/cli.js start",
    "dev": "tsx src/cli.ts start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:selectors": "tsx scripts/selectors-fixture-test.ts",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "csv-parse": "^6.2.1",
    "hono": "^4.12.34",
    "luxon": "^3.7.2",
    "mcp-use": "^2.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
