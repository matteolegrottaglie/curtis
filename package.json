{
  "name": "linkedin-sequencer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sequenziatore personale di richieste di collegamento e messaggi LinkedIn via Playwright. Uso personale, singolo account.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "login": "tsx src/cli/login.ts",
    "typecheck": "tsc --noEmit",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "better-sqlite3": "^12.10.0",
    "csv-parse": "^6.2.1",
    "fastify": "^5.8.5",
    "luxon": "^3.7.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
