# ============================================================
#  LinkedIn Sequencer MCP — configurazione facoltativa
#
#  Copia questo file come  ~/.linkedin-sequencer-mcp/.env
#  (o dentro la directory indicata da LKSQ_DATA_DIR).
#  Le variabili già presenti nell'ambiente hanno la precedenza.
#
#  I parametri di sicurezza veri — rampa, tetti, orari, ritardi —
#  NON stanno qui: si leggono e si cambiano da chat con i tool
#  get_safety_settings / update_safety_settings.
# ============================================================

# --- Dove vivono database, profilo browser, token, log e screenshot ---
# Va impostata come variabile d'ambiente, non qui dentro (serve per trovare
# questo stesso file). Utile per riusare i dati del progetto originale:
#   export LKSQ_DATA_DIR="/percorso/al/vecchio/progetto/data"
# LKSQ_DATA_DIR=~/.linkedin-sequencer-mcp

# --- Porta del daemon (l'endpoint MCP è http://127.0.0.1:PORTA/mcp) ---
# Resta sempre in ascolto solo su 127.0.0.1: non è configurabile, ed è voluto.
LKSQ_PORT=4311

# --- Fuso orario della finestra "orari lavorativi" (formato IANA) ---
TIMEZONE=Europe/Rome

# --- Log: trace | debug | info | warn | error | silent ---
LOG_LEVEL=info

# --- Browser ---
# Mostra la finestra del browser. LASCIA true: la modalità headless
# è molto più facile da rilevare per LinkedIn.
HEADFUL=true

# Canale del browser:
#   chrome  -> Google Chrome installato sul sistema (fingerprint più autentico)
#   (vuoto) -> Chromium incluso in Playwright (serve `npx playwright install chromium`)
BROWSER_CHANNEL=chrome

# --- All'avvio del daemon ---
# Riapre la sessione LinkedIn salvata, così risulti già connesso.
AUTO_CONNECT=true

# Avvia anche il MOTORE all'avvio del daemon: le campagne partono da sole,
# sempre dentro finestra oraria, rampa e tetti. È ciò che imposta
# `lksq service install` nel proprio ambiente. Tienilo false qui, così
# `lksq start` a mano apre solo il server MCP senza inviare nulla.
AUTOSTART_ENGINE=false

# --- Debug ---
# Disattiva il token bearer sull'endpoint MCP. NON usarlo normalmente:
# chiunque sulla macchina potrebbe mandare inviti a tuo nome.
# LKSQ_NO_AUTH=1
