# ============================================================
#  LinkedIn Sequencer MCP — optional configuration
#
#  Copy this file to  ~/.linkedin-sequencer-mcp/.env
#  (or into the directory LKSQ_DATA_DIR points at).
#  Variables already present in the environment always win.
#
#  The real safety parameters — ramp, ceilings, hours, delays —
#  are NOT here. Read and change them from chat with the
#  get_safety_settings / update_safety_settings tools.
# ============================================================

# --- Where database, browser profile, token, logs and screenshots live ---
# Set this as an environment variable, not here: it is needed to locate this
# very file. Useful to reuse data from another installation:
#   export LKSQ_DATA_DIR="/path/to/other/data"
# LKSQ_DATA_DIR=~/.linkedin-sequencer-mcp

# --- Daemon port (the MCP endpoint is http://127.0.0.1:PORT/mcp) ---
# The host is always 127.0.0.1. That is not configurable, by design.
LKSQ_PORT=4311

# --- Time zone for the working-hours window (IANA format) ---
TIMEZONE=Europe/Rome

# --- Logs: trace | debug | info | warn | error | silent ---
LOG_LEVEL=info

# --- Browser ---
# By default the browser works in the BACKGROUND: no window on your screen.
# A window only opens for the login, where you have to type.
#
# This is not the old, easily-detected headless mode: it drives system Chrome,
# rewrites the User-Agent to drop the "Headless" marker, and replays the real
# display values observed during login. Measured: after the first login the
# background fingerprint is identical to the windowed one on every signal
# checked.
#
# HEADFUL=true keeps the window visible. Useful mainly when a selector stops
# matching and you need to look at the page yourself.
# HEADFUL=false

# Browser channel:
#   chrome    -> Google Chrome installed on the system (most authentic fingerprint)
#   chromium  -> force Playwright's bundled Chromium (needs `npx playwright install chromium`)
#   (empty)   -> auto: system Chrome when present, otherwise Playwright's Chromium
BROWSER_CHANNEL=chrome

# --- On daemon start ---
# Reopen the saved LinkedIn session, so you show up already connected.
AUTO_CONNECT=true

# Also start the ENGINE when the daemon starts: campaigns run on their own,
# always inside the time window, ramp and ceilings. This is what
# `lksq service install` sets in its own environment. Keep it false here, so
# that running `lksq start` by hand only opens the MCP server and sends nothing.
AUTOSTART_ENGINE=false

# --- Debug ---
# Disable the bearer token on the MCP endpoint. DO NOT use this normally:
# any process on the machine could then send invites in your name.
# LKSQ_NO_AUTH=1
