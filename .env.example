# ============================================================
#  LinkedIn Sequencer — configurazione infrastruttura
#  Copia questo file in `.env` e adatta i valori.
#  (I parametri di sicurezza/rampa si regolano dalla dashboard,
#   non qui: questi sono solo i settaggi di base del processo.)
# ============================================================

# --- Dashboard web locale ---
# La dashboard ascolta SOLO in locale. Non esporla su 0.0.0.0.
HOST=127.0.0.1
PORT=4310

# --- Dati locali (database SQLite, profilo browser, screenshot, CSV) ---
DATA_DIR=./data

# --- Fuso orario per la finestra "orari lavorativi" (formato IANA) ---
TIMEZONE=Europe/Rome

# --- Log: trace | debug | info | warn | error ---
LOG_LEVEL=info

# --- Browser ---
# Mostra la finestra del browser (headed). LASCIA true:
# la modalità headless è molto più facile da rilevare per LinkedIn.
HEADFUL=true

# Canale del browser:
#   chrome  -> usa Google Chrome installato sul Mac (fingerprint più autentico) [consigliato]
#   (vuoto) -> usa il Chromium incluso in Playwright
BROWSER_CHANNEL=chrome

# Auto-connect all'avvio: riapre la sessione LinkedIn salvata e mostra "Connesso"
# senza cliccare "Accedi". Metti false se non vuoi che il browser parta da solo all'avvio.
AUTO_CONNECT=true
